# Database
# Default: SQLite, zero-install, recommended for local dev (no Postgres/Docker
# required). The DB file is created on first run at backend/greenthread.db.
DATABASE_URL=sqlite:///./greenthread.db

# Postgres alternative (used by docker-compose.yml). Uncomment + comment out
# the SQLite line above when you want to run with Postgres:
# POSTGRES_USER=greenthread
# POSTGRES_PASSWORD=greenthread_password_change_in_production
# POSTGRES_DB=greenthread
# DATABASE_URL=postgresql://greenthread:greenthread_password_change_in_production@db:5432/greenthread

# JWT Authentication
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend
VITE_API_URL=http://localhost:8000/api

# Email (for sending reports - optional for MVP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# OCR — Anthropic Claude vision (used by POST /api/ocr/extract)
ANTHROPIC_API_KEY=
ANTHROPIC_OCR_MODEL=claude-sonnet-4-6

# Report signing — AWS KMS (used by POST /api/reports/generate)
# Leave REPORT_SIGNING_PROVIDER=local in dev to use a local Ed25519 keypair
# stored in the DB. Switch to `kms` in prod.
REPORT_SIGNING_PROVIDER=local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_KMS_KEY_ID=

# Public base URL — embedded into signed PDFs as the verify link
PUBLIC_BASE_URL=http://localhost:5173

# Where generated reports are written. Default is the Docker volume path.
# Outside Docker (e.g. running uvicorn directly on Windows), set this to a
# path that exists on your host, like ./reports.
REPORTS_DIR=./reports
